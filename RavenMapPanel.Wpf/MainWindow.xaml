<Window x:Class="RavenMapPanel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RavenMapPanel"
        Title="Raven Map Studio" Icon="Assets/raven-brand-v3.ico" WindowStartupLocation="CenterScreen" WindowState="Maximized" MinWidth="1180" MinHeight="760">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <Geometry x:Key="IconHome">M3,11 L12,3 L21,11 M5.5,9.5 V21 H18.5 V9.5 M9.5,21 V14 H14.5 V21</Geometry>
        <Geometry x:Key="IconMap">M3,5 L9,3 L15,5 L21,3 V19 L15,21 L9,19 L3,21 Z M9,3 V19 M15,5 V21</Geometry>
        <Geometry x:Key="IconMonument">M4,20 H20 M6,20 V9 H18 V20 M4,9 H20 L17,4 H7 Z M9,12 V17 M12,12 V17 M15,12 V17</Geometry>
        <Geometry x:Key="IconLayers">M12,3 L21,8 L12,13 L3,8 Z M4,12 L12,17 L20,12 M4,16 L12,21 L20,16</Geometry>
        <Geometry x:Key="IconWorld">M12,3 A9,9 0 1 0 12,21 A9,9 0 1 0 12,3 M3,12 H21 M12,3 C16,7 16,17 12,21 M12,3 C8,7 8,17 12,21</Geometry>
        <Geometry x:Key="IconHistory">M4,5 V10 H9 M5,9 A8,8 0 1 1 5.5,17 M12,7 V12 L16,14</Geometry>
        <Geometry x:Key="IconCheck">M4,13 L9,18 L20,6 M4,4 H20 V20 H4 Z</Geometry>
        <Geometry x:Key="IconLogs">M5,6 H19 M5,12 H19 M5,18 H15 M2.5,6 H2.6 M2.5,12 H2.6 M2.5,18 H2.6</Geometry>
        <Geometry x:Key="IconSettings">M12,8 A4,4 0 1 0 12,16 A4,4 0 1 0 12,8 M12,3 V5 M12,19 V21 M3,12 H5 M19,12 H21 M5.6,5.6 L7,7 M17,17 L18.4,18.4 M18.4,5.6 L17,7 M7,17 L5.6,18.4</Geometry>
        <Style x:Key="NavPath" TargetType="Path">
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            <Setter Property="StrokeThickness" Value="1.7"/><Setter Property="StrokeStartLineCap" Value="Round"/><Setter Property="StrokeEndLineCap" Value="Round"/><Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="Width" Value="19"/><Setter Property="Height" Value="19"/><Setter Property="Stretch" Value="Uniform"/>
        </Style>
        <Style x:Key="NavIconBox" TargetType="Border">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Background" Value="#141E28"/>
            <Setter Property="BorderBrush" Value="#2A3947"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="RuleChoiceButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Background" Value="#141E28"/>
            <Setter Property="BorderBrush" Value="#334250"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="RuleRequiredButton" TargetType="Button" BasedOn="{StaticResource RuleChoiceButton}">
            <Setter Property="Foreground" Value="#58D89A"/>
            <Style.Triggers><DataTrigger Binding="{Binding IsRequired}" Value="True"><Setter Property="Background" Value="#173B2D"/><Setter Property="BorderBrush" Value="#37A36F"/><Setter Property="Foreground" Value="#8BF0BD"/></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="RuleOptionalButton" TargetType="Button" BasedOn="{StaticResource RuleChoiceButton}">
            <Setter Property="Foreground" Value="#EAC95C"/>
            <Style.Triggers><DataTrigger Binding="{Binding IsOptional}" Value="True"><Setter Property="Background" Value="#403719"/><Setter Property="BorderBrush" Value="#B49532"/><Setter Property="Foreground" Value="#FFE17A"/></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="RuleBlockedButton" TargetType="Button" BasedOn="{StaticResource RuleChoiceButton}">
            <Setter Property="Foreground" Value="#EE747C"/>
            <Style.Triggers><DataTrigger Binding="{Binding IsBlocked}" Value="True"><Setter Property="Background" Value="#401F25"/><Setter Property="BorderBrush" Value="#B84B54"/><Setter Property="Foreground" Value="#FF9CA2"/></DataTrigger></Style.Triggers>
        </Style>
        <DataTemplate x:Key="MonumentRowTemplate" DataType="{x:Type local:MonumentRuleViewModel}">
            <Border Width="420" MinHeight="96" Background="#101821" BorderBrush="#293744" BorderThickness="1" CornerRadius="12" Padding="12" Margin="5">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="62"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Width="56" Height="56" CornerRadius="28" Background="#17232D" BorderBrush="#3A4C5A" BorderThickness="2" VerticalAlignment="Top"><Image Source="{Binding IconPath}" Width="46" Height="46" Stretch="Uniform"/></Border>
                    <StackPanel Grid.Column="1" Margin="10,3,8,0">
                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Category}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                        <ComboBox Width="168" Height="34" MinHeight="34" Margin="0,8,0,0" HorizontalAlignment="Left"
                                  ItemsSource="{Binding PrefabOptions}" DisplayMemberPath="Name"
                                  SelectedValuePath="Id" SelectedValue="{Binding SelectedPrefabVariantId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Visibility="{Binding CustomPrefabAvailable, Converter={StaticResource BoolToVisibility}}"
                                  ToolTip="Monument görünümünü seç"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource RuleRequiredButton}" Content="✓" Tag="{Binding}" CommandParameter="Required" Click="SetRuleState_Click" ToolTip="Bu monument kesin olsun"/>
                            <Button Style="{StaticResource RuleOptionalButton}" Content="?" Tag="{Binding}" CommandParameter="Optional" Click="SetRuleState_Click" ToolTip="İsteğe bağlı"/>
                            <Button Style="{StaticResource RuleBlockedButton}" Content="×" Tag="{Binding}" CommandParameter="Blocked" Click="SetRuleState_Click" ToolTip="Bu monument olmasın"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0" Visibility="{Binding IsGodRock, Converter={StaticResource BoolToVisibility}}" ToolTip="Large God Rock hedef adedi">
                            <Button Content="−" Width="28" Height="28" MinHeight="28" Padding="0" Tag="{Binding}" Click="GodRockMinus_Click"/>
                            <Border Background="#171F29" BorderBrush="#3B4856" BorderThickness="1" CornerRadius="6" Margin="5,0" MinWidth="34" Height="28"><TextBlock Text="{Binding TargetCount}" Foreground="{StaticResource AccentSoftBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <Button Content="+" Width="28" Height="28" MinHeight="28" Padding="0" Tag="{Binding}" Click="GodRockPlus_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
        <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="Foreground" Value="#9DA9B6"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="10"/><Setter Property="Margin" Value="0,0,0,11"/></Style>
        <Style x:Key="PageTitle" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="26"/></Style>
        <Style x:Key="Metric" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="23"/></Style>
        <Style x:Key="StudioStepButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Background" Value="#111A23"/>
            <Setter Property="BorderBrush" Value="#293744"/>
            <Setter Property="Foreground" Value="#8C9BAD"/>
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="6,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="StudioStepButtonActive" TargetType="Button" BasedOn="{StaticResource StudioStepButton}">
            <Setter Property="Background" Value="#1D1C1D"/>
            <Setter Property="BorderBrush" Value="#C6532E"/>
            <Setter Property="Foreground" Value="#FFF2EB"/>
        </Style>
        <Style x:Key="HeroArrowButton" TargetType="Button">
            <Setter Property="Width" Value="25"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Foreground" Value="#B9C7D2"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#FFFFFF"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.55"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource WindowBrush}">
        <Grid.RowDefinitions><RowDefinition Height="66"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#101720" BorderBrush="#26313D" BorderThickness="0,0,0,1">
            <Grid Margin="18,0"><Grid.ColumnDefinitions><ColumnDefinition Width="214"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="42" Height="42" CornerRadius="0" Background="#0D100E" BorderBrush="#3A403B" BorderThickness="1"><Image Source="Assets/raven-brand-v3.png" Width="40" Height="40" Stretch="Uniform"/></Border><StackPanel Margin="11,0,0,0" VerticalAlignment="Center"><TextBlock Text="Raven Map Studio" Foreground="#F5F8FB" FontWeight="SemiBold" FontSize="16"/><TextBlock x:Name="VersionTextBlock" Text="V1.0.12" Foreground="#8492A4" FontWeight="SemiBold" FontSize="9" Margin="0,2,0,0"/></StackPanel></StackPanel>
                <Border Grid.Column="1" Background="#151E29" BorderBrush="#2A3543" BorderThickness="1" CornerRadius="9" Padding="13,8" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="18,0,0,0"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconMap}" Style="{StaticResource NavPath}" Stroke="#8695A7" Width="16" Height="16"/><TextBlock x:Name="ProjectTitle" Text="Yeni harita" Foreground="#EAF2F8" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/><TextBlock x:Name="ProjectMetaText" Text="  · 4500 · Procedural" Foreground="#748398" FontSize="10" VerticalAlignment="Center"/></StackPanel></Border>
                <Border Grid.Column="2" Background="#12352C" BorderBrush="#235141" BorderThickness="1" CornerRadius="9" Padding="13,8" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" Margin="0,0,8,0"/><TextBlock x:Name="TopStatus" Text="Hazır" Foreground="#9FE6C8" FontWeight="SemiBold" FontSize="11"/></StackPanel></Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="214"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#0D141C" BorderBrush="#222C38" BorderThickness="0,0,1,0" Padding="12,18">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
                        <TextBlock Text="STUDIO" Style="{StaticResource SectionTitle}" Margin="10,3,0,7"/>
                        <Button x:Name="NavDashboard" Style="{StaticResource NavButton}" Tag="Dashboard" Click="Navigate_Click"><StackPanel Orientation="Horizontal"><Border Style="{StaticResource NavIconBox}"><Path Style="{StaticResource NavPath}" Data="{StaticResource IconHome}" Width="17" Height="17"/></Border><TextBlock Text="Başlangıç" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
                        <Button x:Name="NavStudio" Style="{StaticResource NavButton}" Tag="Studio" Click="Navigate_Click"><StackPanel Orientation="Horizontal"><Border Style="{StaticResource NavIconBox}"><Path Style="{StaticResource NavPath}" Data="{StaticResource IconMap}" Width="17" Height="17"/></Border><TextBlock Text="Harita Studio" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
                        <TextBlock Text="DÜNYA" Style="{StaticResource SectionTitle}" Margin="10,18,0,7"/>
                        <Button x:Name="NavMonuments" Style="{StaticResource NavButton}" Tag="Monuments" Click="Navigate_Click"><StackPanel Orientation="Horizontal"><Border Style="{StaticResource NavIconBox}"><Path Style="{StaticResource NavPath}" Data="{StaticResource IconMonument}" Width="17" Height="17"/></Border><TextBlock Text="Monument Kuralları" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
                        <Button x:Name="NavIcons" Style="{StaticResource NavButton}" Tag="Icons" Click="Navigate_Click"><StackPanel Orientation="Horizontal"><Border Style="{StaticResource NavIconBox}"><Path Style="{StaticResource NavPath}" Data="{StaticResource IconLayers}" Width="17" Height="17"/></Border><TextBlock Text="İkonlar ve Katmanlar" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
                        <Button x:Name="NavAdvanced" Style="{StaticResource NavButton}" Tag="Advanced" Click="Navigate_Click"><StackPanel Orientation="Horizontal"><Border Style="{StaticResource NavIconBox}"><Path Style="{StaticResource NavPath}" Data="{StaticResource IconWorld}" Width="17" Height="17"/></Border><TextBlock Text="Biyom &amp; Dünya" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
                        <TextBlock Text="KÜTÜPHANE" Style="{StaticResource SectionTitle}" Margin="10,18,0,7"/>
                        <Button x:Name="NavHistory" Style="{StaticResource NavButton}" Tag="History" Click="Navigate_Click"><StackPanel Orientation="Horizontal"><Border Style="{StaticResource NavIconBox}"><Path Style="{StaticResource NavPath}" Data="{StaticResource IconHistory}" Width="17" Height="17"/></Border><TextBlock Text="Üretimler" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
                        <Button x:Name="NavValidation" Style="{StaticResource NavButton}" Tag="Validation" Click="Navigate_Click"><StackPanel Orientation="Horizontal"><Border Style="{StaticResource NavIconBox}"><Path Style="{StaticResource NavPath}" Data="{StaticResource IconCheck}" Width="17" Height="17"/></Border><TextBlock Text="Doğrulama" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
                        <Button x:Name="NavLogs" Style="{StaticResource NavButton}" Tag="Logs" Click="Navigate_Click"><StackPanel Orientation="Horizontal"><Border Style="{StaticResource NavIconBox}"><Path Style="{StaticResource NavPath}" Data="{StaticResource IconLogs}" Width="17" Height="17"/></Border><TextBlock Text="Aktivite" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
                        <Button x:Name="NavSettings" Style="{StaticResource NavButton}" Tag="Settings" Click="Navigate_Click"><StackPanel Orientation="Horizontal"><Border Style="{StaticResource NavIconBox}"><Path Style="{StaticResource NavPath}" Data="{StaticResource IconSettings}" Width="17" Height="17"/></Border><TextBlock Text="Ayarlar" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
                    </StackPanel></ScrollViewer>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="24">
                <!-- Dashboard -->
                <Grid x:Name="DashboardPage">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border x:Name="DashboardCriticalBar" Visibility="Collapsed" Background="#3A191A" BorderBrush="#A94B4F" BorderThickness="1" CornerRadius="10" Padding="13,9" Margin="0,0,0,10"><DockPanel><TextBlock Text="!" Foreground="#FF8B8F" FontWeight="Bold" FontSize="18" Margin="0,0,10,0"/><TextBlock x:Name="DashboardCriticalText" Foreground="#FFD5D7" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel></Border>
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                        <Border CornerRadius="15" ClipToBounds="True" BorderBrush="#314251" BorderThickness="1" MinHeight="360">
                            <Grid>
                                <local:RemoteImage x:Name="DashboardHeroImage" Source="Assets/backgrounds/arkaplan-5.jpg" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5"><GradientStop Color="#B8080D13" Offset="0"/><GradientStop Color="#1A080D13" Offset="0.58"/><GradientStop Color="#50080D13" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
                                <Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1"><GradientStop Color="#00000000" Offset="0.45"/><GradientStop Color="#C8080D13" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
                                <StackPanel VerticalAlignment="Bottom" Margin="30,28" MaxWidth="650" HorizontalAlignment="Left">
                                    <TextBlock Text="RAVEN MAP STÜDYO" Foreground="#F08B68" FontWeight="Bold" FontSize="10"/>
                                    <TextBlock Text="Haritanı Tasarla, Doğrula ve Üret" Foreground="#FFFFFF" FontWeight="Bold" FontSize="29" Margin="0,7,0,0"/>
                                    <TextBlock Text="Dünya yapısını, monumentleri ve özel görünümleri tek ayar dosyasında yönetin." Foreground="#D5DEE5" FontSize="12" Margin="0,7,0,0"/>
                                    <Button Style="{StaticResource PrimaryButton}" Content="Harita Oluşturmaya Başla  →" Padding="16,9" HorizontalAlignment="Left" Margin="0,15,0,0" Click="GoStudio_Click"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0">
                                    <Button Style="{StaticResource HeroArrowButton}" Content="‹" Click="PreviousHero_Click" ToolTip="Önceki fotoğraf"/>
                                    <Button Style="{StaticResource HeroArrowButton}" Content="›" Click="NextHero_Click" ToolTip="Sonraki fotoğraf"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Background="#111A23" BorderBrush="#2C3B48" BorderThickness="1" CornerRadius="14" ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="4"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Border x:Name="DashboardAnnouncementAccent" Background="#D9572B"/>
                                <Grid Grid.Row="1" Margin="20,16,20,18">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <DockPanel LastChildFill="True">
                                        <Border x:Name="DashboardAnnouncementBadge" DockPanel.Dock="Left" Background="#253342" BorderBrush="#405363" BorderThickness="1" CornerRadius="8" Padding="9,5" Margin="0,0,12,0"><TextBlock x:Name="DashboardAnnouncementLevelText" Text="BİLGİ" Foreground="#AFC2D1" FontSize="9" FontWeight="Bold"/></Border>
                                        <TextBlock x:Name="DashboardAnnouncementPeriod" Foreground="#8198A9" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    </DockPanel>
                                    <TextBlock x:Name="DashboardAnnouncementTitle" Grid.Row="1" Text="Raven Map Studio'ya Hoş Geldiniz" Foreground="#F5F8FB" FontSize="22" LineHeight="27" FontWeight="Bold" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                    <TextBlock x:Name="DashboardAnnouncementMessage" Grid.Row="2" Text="Duyurular, yenilikler ve bakım bildirimleri burada açık ve düzenli biçimde gösterilir." Foreground="#B9C7D2" FontSize="12" LineHeight="19" TextWrapping="Wrap" Margin="0,7,0,0" MaxHeight="92"/>
                                    <ScrollViewer x:Name="DashboardAnnouncementImagesScroller" Grid.Row="3" Visibility="Collapsed" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,14,0,0">
                                        <StackPanel x:Name="DashboardAnnouncementImagesPanel" Orientation="Horizontal"/>
                                    </ScrollViewer>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- Studio -->
                <Grid x:Name="StudioPage" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition x:Name="StudioHeaderRow" Height="76"/><RowDefinition Height="62"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid x:Name="StudioHeader" Margin="2,0,2,10">
                        <StackPanel VerticalAlignment="Center"><TextBlock Text="HARİTA STUDIO" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="10"/><TextBlock Text="Yeni dünyanı oluştur" Style="{StaticResource PageTitle}" Margin="0,3,0,0"/><TextBlock Text="Dünya ayarlarını tamamla, monumentleri seç ve tek ekrandan üret." Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/></StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0"><Ellipse Width="7" Height="7" Fill="#55C994" Margin="0,0,7,0"/><TextBlock Text="Ayarlar otomatik saklanır" Foreground="#8BB5A6" VerticalAlignment="Center" FontSize="10"/></StackPanel><Button Style="{StaticResource PrimaryButton}" Content="MAP içe aktar" Padding="15,8" Click="ImportMap_Click" ToolTip="Dışarıdan alınan Rust .map dosyasını otomatik algıla ve aç"/></StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,12">
                        <UniformGrid Columns="4">
                            <Button Style="{StaticResource StudioStepButtonActive}" IsHitTestVisible="False"><StackPanel Orientation="Horizontal"><Border Width="24" Height="24" CornerRadius="6" Background="#D9572B"><TextBlock Text="1" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/></Border><TextBlock Text="Dünya" Margin="9,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
                            <Button Style="{StaticResource StudioStepButton}" Tag="Monuments" Click="Navigate_Click"><StackPanel Orientation="Horizontal"><Border Width="24" Height="24" CornerRadius="6" Background="#202A35"><TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Monumentler" Margin="9,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
                            <Button Style="{StaticResource StudioStepButton}" Tag="Icons" Click="Navigate_Click"><StackPanel Orientation="Horizontal"><Border Width="24" Height="24" CornerRadius="6" Background="#202A35"><TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Görünüm" Margin="9,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
                            <Button Style="{StaticResource StudioStepButton}" Tag="Validation" Click="Navigate_Click"><StackPanel Orientation="Horizontal"><Border Width="24" Height="24" CornerRadius="6" Background="#202A35"><TextBlock Text="4" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Kontrol &amp; Üret" Margin="9,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
                        </UniformGrid>
                    </Border>
                    <Grid x:Name="StudioMainGrid" Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="StudioSettingsColumn" Width="380"/></Grid.ColumnDefinitions>
                        <Grid x:Name="StudioMapArea" Margin="0,0,12,0"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition x:Name="StudioLogRow" Height="150"/></Grid.RowDefinitions>
                            <Border Background="#061019" BorderBrush="#2A3743" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
                                <Grid><local:MapViewport x:Name="MapView" Margin="1"/>
                                    <local:TerrainDraftCanvas x:Name="TerrainDraftView" Margin="1" Visibility="Collapsed"/>
