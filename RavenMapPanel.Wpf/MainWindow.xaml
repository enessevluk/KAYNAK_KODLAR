                                    <Border Background="#151B1A" BorderBrush="#4A3C2C" BorderThickness="1" CornerRadius="8" Padding="11" Margin="0,4,0,8">
                                        <StackPanel>
                                            <TextBlock Text="ÖNERİLEN DENGE" Foreground="#E0B36B" FontSize="9" FontWeight="Bold" Margin="0,0,0,5"/>
                                            <TextBlock Text="30 / 30 / 40 dengeli başlangıç değeridir. Özellikle Tier 0'ı sıfıra veya çok düşük seviyeye indirmeyin." Foreground="#D7C3A3" FontSize="10" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#0E1B20" BorderBrush="#2B4650" BorderThickness="1" CornerRadius="8" Padding="11" Margin="0,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="UYGULANACAK ORAN" Foreground="#7FA6B4" FontSize="9" FontWeight="Bold" Margin="0,0,0,5"/>
                                            <TextBlock x:Name="TierSummaryText" Foreground="#D8E2E9" FontSize="11" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- CUSTOM PREFABS -->
                            <Border Grid.Column="4" Style="{StaticResource Card}" VerticalAlignment="Top">
                                <StackPanel>
                                    <TextBlock Text="ÖZEL MONUMENT GÖRÜNÜMLERİ" Style="{StaticResource SectionTitle}" Margin="0,0,0,5"/>
                                    <TextBlock Text="Raven Server tarafından planınıza açılan monument görünümleri listelenir. Premium içerikler yalnızca Premium abonelik aktifken görünür." Foreground="#C5CED7" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <Border Background="#111A23" BorderBrush="#2A3947" BorderThickness="1" CornerRadius="8" Padding="11" Margin="0,12,0,12">
                                        <StackPanel>
                                            <TextBlock Text="Dosyalar bilgisayarınızda kalıcı olarak saklanmaz. Seçilen içerik üretim sırasında güvenli biçimde alınır, doğrulanır ve işlem sonunda temizlenir." Foreground="#9FB0BF" FontSize="11" TextWrapping="Wrap"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                <Button Content="Yetkili Listeyi Yenile" Style="{StaticResource ButtonBase}" Click="RefreshCustomPrefabs_Click" Padding="10,7"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding CustomPrefabItems}">
                                        <ItemsControl.ItemTemplate><DataTemplate>
                                            <Border Style="{StaticResource SubCard}" Margin="0,0,0,8" Padding="12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="#ECF2F6"/>
                                                        <TextBlock Text="{Binding PrefabAvailabilityText}" Foreground="{Binding PrefabAvailabilityColor}" FontSize="10" FontWeight="SemiBold" Margin="0,3,8,0" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding PrefabStatusText}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,3,8,0" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <ComboBox Grid.Column="1" Margin="5,0,8,0" VerticalAlignment="Center"
                                                              ItemsSource="{Binding PrefabOptions}" DisplayMemberPath="Name"
                                                              SelectedValuePath="Id" SelectedValue="{Binding SelectedPrefabVariantId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </Grid>

                <!-- Monument manager -->
                <Grid x:Name="MonumentsPage" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="62"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="2,0,2,10">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Monumentler" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="Dünyanda bulunacak yapıları hızlıca ara, filtrele ve belirle." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
                        </StackPanel>
                        <Button Style="{StaticResource ButtonBase}" Content="Kuralları Sıfırla" HorizontalAlignment="Right" VerticalAlignment="Center" Click="ResetRules_Click"/>
                    </Grid>
                    <Border Grid.Row="1" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,12">
                        <UniformGrid Columns="4">
                            <Button Style="{StaticResource StudioStepButton}" Click="GoStudio_Click"><StackPanel Orientation="Horizontal"><Border Width="24" Height="24" CornerRadius="6" Background="#202A35"><TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Dünya" Margin="9,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
                            <Button Style="{StaticResource StudioStepButtonActive}" IsHitTestVisible="False"><StackPanel Orientation="Horizontal"><Border Width="24" Height="24" CornerRadius="6" Background="#D9572B"><TextBlock Text="2" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/></Border><TextBlock Text="Monumentler" Margin="9,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
                            <Button Style="{StaticResource StudioStepButton}" Tag="Icons" Click="Navigate_Click"><StackPanel Orientation="Horizontal"><Border Width="24" Height="24" CornerRadius="6" Background="#202A35"><TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Görünüm" Margin="9,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
                            <Button Style="{StaticResource StudioStepButton}" Tag="Validation" Click="Navigate_Click"><StackPanel Orientation="Horizontal"><Border Width="24" Height="24" CornerRadius="6" Background="#202A35"><TextBlock Text="4" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Kontrol &amp; Üret" Margin="9,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
                        </UniformGrid>
                    </Border>
                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="34"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="MonumentSearch" TextChanged="Search_TextChanged" ToolTip="Monument ara"/>
                                <ComboBox x:Name="CategoryBox" Grid.Column="1" Margin="10,0,0,0" SelectionChanged="Category_Changed" ToolTip="Kategoriye göre filtrele"/>
                                <ComboBox x:Name="StateFilterBox" Grid.Column="2" Margin="10,0,0,0" SelectionChanged="StateFilter_Changed" ToolTip="Kural durumuna göre filtrele"/>
                            </Grid>
                            <Grid Grid.Row="1" Margin="2,7,2,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Gösterilen:" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                                    <TextBlock x:Name="FilterCountText" Text="0" Foreground="#D8E0E7" FontWeight="SemiBold" FontSize="10" Margin="5,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock Text="✓ Olsun" Foreground="#58D89A" FontSize="10"/><TextBlock Text="   ? İsteğe bağlı" Foreground="#EAC95C" FontSize="10"/><TextBlock Text="   × Olmasın" Foreground="#EE747C" FontSize="10"/></StackPanel>
                            </Grid>
                            <ListBox x:Name="FullMonumentList" Grid.Row="2" Margin="0,10,0,0" ItemsSource="{Binding MonumentView}" ItemTemplate="{StaticResource MonumentRowTemplate}" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Icons -->
                <Grid x:Name="IconsPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="62"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid><StackPanel><TextBlock Text="Harita Görünümü" Style="{StaticResource PageTitle}"/><TextBlock Text="İkon temasını ve görünür harita katmanlarını yönet." Foreground="{StaticResource MutedBrush}"/></StackPanel><Button Style="{StaticResource PrimaryButton}" Content="＋ Yeni Monument" HorizontalAlignment="Right" VerticalAlignment="Center" Click="AddMonument_Click"/></Grid>
                    <Border Grid.Row="1" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,12">
                        <UniformGrid Columns="4">
                            <Button Style="{StaticResource StudioStepButton}" Click="GoStudio_Click"><StackPanel Orientation="Horizontal"><Border Width="24" Height="24" CornerRadius="6" Background="#202A35"><TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Dünya" Margin="9,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
                            <Button Style="{StaticResource StudioStepButton}" Tag="Monuments" Click="Navigate_Click"><StackPanel Orientation="Horizontal"><Border Width="24" Height="24" CornerRadius="6" Background="#202A35"><TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Monumentler" Margin="9,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
                            <Button Style="{StaticResource StudioStepButtonActive}" IsHitTestVisible="False"><StackPanel Orientation="Horizontal"><Border Width="24" Height="24" CornerRadius="6" Background="#D9572B"><TextBlock Text="3" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/></Border><TextBlock Text="Görünüm" Margin="9,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
                            <Button Style="{StaticResource StudioStepButton}" Tag="Validation" Click="Navigate_Click"><StackPanel Orientation="Horizontal"><Border Width="24" Height="24" CornerRadius="6" Background="#202A35"><TextBlock Text="4" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Kontrol &amp; Üret" Margin="9,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
                        </UniformGrid>
                    </Border>
                    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="HARİTA GÖRÜNÜMÜ" Style="{StaticResource SectionTitle}"/><TextBlock Text="İkon boyutu"/><Slider x:Name="IconSizeSlider" Minimum="24" Maximum="72" Value="72" TickFrequency="2" IsSnapToTickEnabled="True" Margin="0,8" ValueChanged="IconSize_Changed"/><TextBlock x:Name="IconSizeLabel" Text="72 px" Foreground="{StaticResource AccentBrush}"/><CheckBox x:Name="ShowIconsCheck" Content="Raven ikonlarını göster" IsChecked="True" Checked="Layer_Changed" Unchecked="Layer_Changed" Margin="0,20,0,5"/><CheckBox x:Name="ShowEnvironmentCheck" Content="Çevre ve altyapı ikonlarını göster" IsChecked="True" Checked="Layer_Changed" Unchecked="Layer_Changed"/><Button Style="{StaticResource ButtonBase}" Content="Haritada Önizle" Margin="0,20,0,0" Click="GoStudio_Click"/><Border Background="#10231F" BorderBrush="#285044" BorderThickness="1" CornerRadius="7" Padding="11" Margin="0,20,0,0"><TextBlock Text="PNG · 64–512 px" Foreground="#D6A47F" TextWrapping="Wrap"/></Border></StackPanel></Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="12"><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding IconItems}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Width="178" Height="146" Margin="6" Background="#121A23" BorderBrush="#2B3947" BorderThickness="1" CornerRadius="10"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="28"/></Grid.RowDefinitions><StackPanel VerticalAlignment="Center"><Image Source="{Binding IconPath}" Width="72" Height="72" Stretch="Uniform"/><TextBlock Text="{Binding Name}" Foreground="#EAF2F8" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="7,7,7,0"/></StackPanel><Border Grid.Row="1" Background="#111922" CornerRadius="0,0,8,8"><TextBlock Text="{Binding SourceLabel}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="10"/></Border></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Border>
                    </Grid>
                </Grid>

                <!-- History and comparison -->
                <Grid x:Name="HistoryPage" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="2,0,2,10">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Üretim Kütüphanesi" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="Önceki dünyalarını aç, karşılaştır veya güvenli biçimde yönet." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
                        </StackPanel>
                        <Button Style="{StaticResource ButtonBase}" Content="Yenile" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="14,8" Click="RefreshHistory_Click"/>
                    </Grid>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="0.95*"/></Grid.ColumnDefinitions>

                        <Border Style="{StaticResource Card}" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <Grid>
                                    <TextBlock Text="ÜRETİM GEÇMİŞİ" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="HistoryCountText" Text="0 kayıt" Foreground="{StaticResource MutedBrush}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <ListBox x:Name="HistoryList" Grid.Row="1" Background="Transparent" BorderThickness="0" ScrollViewer.CanContentScroll="True">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#111A23" BorderBrush="#293744" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="126"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <Border Width="112" Height="76" CornerRadius="9" Background="#09131B" BorderBrush="#2A3A47" BorderThickness="1" ClipToBounds="True" VerticalAlignment="Top"><Image Source="{Binding ImagePath}" Stretch="UniformToFill"/></Border>
                                                    <StackPanel Grid.Column="1" Margin="12,1,0,0">
                                                        <TextBlock Text="{Binding DisplayName}" Foreground="#EDF3F7" FontWeight="SemiBold" FontSize="13"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0"><Border Background="{Binding SourceBackground}" CornerRadius="6" Padding="7,3" Margin="0,0,7,0"><TextBlock Text="{Binding SourceText}" Foreground="{Binding SourceColor}" FontSize="8" FontWeight="SemiBold"/></Border><TextBlock Text="{Binding GeneratedText}" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/></StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                                            <TextBlock Text="{Binding SummaryText}" Foreground="#AEBBC6" FontSize="10"/>
                                                            <TextBlock Text="  ·  " Foreground="#566573" FontSize="10"/>
                                                            <TextBlock Text="{Binding ValidationText}" Foreground="{Binding ValidationColor}" FontSize="10" FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding BackupText}" Foreground="#D9A36F" FontSize="9" Margin="0,5,0,0"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="14,0,0,0">
                                                        <Button Style="{StaticResource PrimaryButton}" Content="Haritayı Aç" Padding="11,6" Tag="{Binding}" Click="LoadHistory_Click"/>
                                                        <Button Style="{StaticResource ButtonBase}" Content="Klasörü Aç" Padding="11,6" Margin="0,6,0,0" Tag="{Binding}" Click="OpenHistoryFolder_Click"/>
                                                        <Button Style="{StaticResource ButtonBase}" Content="Haritayı Sil" Foreground="#FF9B9B" BorderBrush="#71383B" Padding="11,6" Margin="0,6,0,0" Tag="{Binding}" Click="DeleteHistory_Click" ToolTip="Bu haritanın Maps içindeki tüm çıktı klasörünü kalıcı olarak sil"/>
                                                        <Button Style="{StaticResource ButtonBase}" Content="Yedeği Aç" Padding="11,6" Margin="0,6,0,0" Tag="{Binding}" Click="OpenHistoryBackup_Click" Visibility="{Binding HasBackup, Converter={StaticResource BoolToVisibility}}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Border Grid.Row="1" Background="#111A24">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers><DataTrigger Binding="{Binding ElementName=HistoryList, Path=Items.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360">
                                        <Border Width="58" Height="58" CornerRadius="16" Background="#17232E" BorderBrush="#30404D" BorderThickness="1" HorizontalAlignment="Center"><Path Data="{StaticResource IconHistory}" Style="{StaticResource NavPath}" Width="25" Height="25" Stroke="#8D9BAC"/></Border>
                                        <TextBlock Text="Henüz üretilmiş harita yok" Foreground="#E6ECF2" FontSize="17" FontWeight="SemiBold" TextAlignment="Center" Margin="0,16,0,0"/>
                                        <TextBlock Text="İlk haritanı ürettiğinde burada açabilir, karşılaştırabilir ve yedeklerini yönetebilirsin." Foreground="{StaticResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,7,0,14"/>
                                        <Button Style="{StaticResource PrimaryButton}" Content="Harita Studio'ya git  →" HorizontalAlignment="Center" Click="GoStudio_Click"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="86"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Text="KARŞILAŞTIR" Style="{StaticResource SectionTitle}" Margin="0,0,0,5"/>
                                    <TextBlock Text="İki üretimi seçin; monument ve çevre öğelerinin adet farklarını görün." Foreground="#C5CED7" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Grid Grid.Row="1" Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Harita A" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="1,0,0,5"/><ComboBox x:Name="CompareABox" DisplayMemberPath="DisplayName"/></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="Harita B" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="1,0,0,5"/><ComboBox x:Name="CompareBBox" DisplayMemberPath="DisplayName"/></StackPanel>
                                </Grid>
                                <Grid Grid.Row="2" Margin="0,12,0,0">
                                    <TextBlock x:Name="CompareSummaryText" Text="Karşılaştırmak için iki üretim seçin." Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,130,0"/>
                                    <Button Style="{StaticResource PrimaryButton}" Content="Karşılaştır" Padding="14,7" HorizontalAlignment="Right" Click="CompareHistory_Click"/>
                                </Grid>
                                <Border Grid.Row="3" Background="#0D1720" BorderBrush="#30404D" BorderThickness="1" CornerRadius="10" Margin="0,13,0,0" Padding="12,10">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="180"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center"><TextBlock Text="MONUMENT / KATMAN" Foreground="#AEBAC5" FontSize="10" FontWeight="SemiBold"/><TextBlock Text="Yalnız adedi değişen öğeler" Foreground="#718190" FontSize="9" Margin="0,4,0,0"/></StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0"><TextBlock Text="HARİTA A" Foreground="#69BFD9" FontSize="9" FontWeight="Bold"/><TextBlock x:Name="CompareTableHeaderA" Text="Harita A" Foreground="#CDE7F0" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/><TextBlock x:Name="CompareMapNameA" Text="Harita seçilmedi" Visibility="Collapsed"/><TextBlock x:Name="CompareIconCountA" Text="" Visibility="Collapsed"/></StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0"><TextBlock Text="HARİTA B" Foreground="#E5A16D" FontSize="9" FontWeight="Bold"/><TextBlock x:Name="CompareTableHeaderB" Text="Harita B" Foreground="#F1D9C8" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/><TextBlock x:Name="CompareMapNameB" Text="Harita seçilmedi" Visibility="Collapsed"/><TextBlock x:Name="CompareIconCountB" Text="" Visibility="Collapsed"/></StackPanel>
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="FARK" Foreground="#F09A76" FontSize="9" FontWeight="Bold"/><TextBlock x:Name="CompareChangedCount" Text="—" Foreground="#FFB08F" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" Margin="0,3,0,0"/></StackPanel>
                                </Grid>
                                </Border>
                                <ListBox x:Name="ComparisonList" Grid.Row="4" Margin="0,10,0,0" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style></ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#101A23" BorderBrush="#2A3946" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="180"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" Foreground="#E2E9EF" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding CountA}" Foreground="#79D0EA" FontSize="13" FontWeight="SemiBold" TextAlignment="Center" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding CountB}" Foreground="#F0A979" FontSize="13" FontWeight="SemiBold" TextAlignment="Center" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding DifferenceText}" Foreground="{Binding DifferenceColor}" FontSize="13" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Border Grid.Row="4" Background="#111A24" Margin="0,10,0,0">
                                    <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ElementName=ComparisonList, Path=Items.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="330">
                                        <TextBlock Text="↔" Foreground="#617387" FontSize="32" TextAlignment="Center"/>
                                        <TextBlock x:Name="ComparisonEmptyTitle" Text="Karşılaştırma bekleniyor" Foreground="#DDE5ED" FontSize="15" FontWeight="SemiBold" TextAlignment="Center" Margin="0,8,0,0"/>
                                        <TextBlock x:Name="ComparisonEmptyDetail" Text="İki farklı harita seçildiğinde yalnız değişen monument ve katmanlar burada gösterilir." Foreground="{StaticResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- Validation -->
                <Grid x:Name="ValidationPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="62"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="2,0,2,10"><StackPanel VerticalAlignment="Center"><TextBlock Text="Üretim Kontrolü" Style="{StaticResource PageTitle}"/><TextBlock Text="Kuralların üretilen dünyadaki sonucunu tek bakışta kontrol et." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/></StackPanel><Button Style="{StaticResource PrimaryButton}" Content="Yeniden kontrol et" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="18,9" Click="Validate_Click"/></Grid>
                    <Border Grid.Row="1" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,12">
                        <UniformGrid Columns="4">
                            <Button Style="{StaticResource StudioStepButton}" Click="GoStudio_Click"><StackPanel Orientation="Horizontal"><Border Width="24" Height="24" CornerRadius="6" Background="#202A35"><TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Dünya" Margin="9,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
                            <Button Style="{StaticResource StudioStepButton}" Tag="Monuments" Click="Navigate_Click"><StackPanel Orientation="Horizontal"><Border Width="24" Height="24" CornerRadius="6" Background="#202A35"><TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Monumentler" Margin="9,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
                            <Button Style="{StaticResource StudioStepButton}" Tag="Icons" Click="Navigate_Click"><StackPanel Orientation="Horizontal"><Border Width="24" Height="24" CornerRadius="6" Background="#202A35"><TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Görünüm" Margin="9,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
                            <Button Style="{StaticResource StudioStepButtonActive}" IsHitTestVisible="False"><StackPanel Orientation="Horizontal"><Border Width="24" Height="24" CornerRadius="6" Background="#D9572B"><TextBlock Text="4" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/></Border><TextBlock Text="Kontrol &amp; Üret" Margin="9,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
                        </UniformGrid>
                    </Border>
                    <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="92"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}" Padding="16"><StackPanel><TextBlock Text="KURAL" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="ValidationTotalText" Text="0" Style="{StaticResource Metric}"/></StackPanel></Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16"><StackPanel><TextBlock Text="BAŞARILI" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="ValidationSuccessText" Text="0" Style="{StaticResource Metric}" Foreground="{StaticResource SuccessBrush}"/></StackPanel></Border>
                            <Border Grid.Column="4" Style="{StaticResource Card}" Padding="16"><StackPanel><TextBlock Text="SORUN" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="ValidationErrorText" Text="0" Style="{StaticResource Metric}" Foreground="{StaticResource ErrorBrush}"/></StackPanel></Border>
                        </Grid>
                        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="18">
                            <Grid>
                                <RichTextBox x:Name="ValidationText" IsReadOnly="True" IsDocumentEnabled="False" Background="Transparent" BorderThickness="0" Padding="0" FontFamily="Segoe UI Variable Text" FontSize="13" VerticalScrollBarVisibility="Auto"><FlowDocument PagePadding="0"/></RichTextBox>
                                <Border Background="#111A24">
                                    <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ElementName=ValidationTotalText, Path=Text}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="390">
                                        <Border Width="58" Height="58" CornerRadius="16" Background="#17232E" BorderBrush="#30404D" BorderThickness="1" HorizontalAlignment="Center"><Path Data="{StaticResource IconCheck}" Style="{StaticResource NavPath}" Width="25" Height="25" Stroke="#8D9BAC"/></Border>
                                        <TextBlock Text="Kontrol edilecek üretim yok" Foreground="#E6ECF2" FontSize="17" FontWeight="SemiBold" TextAlignment="Center" Margin="0,16,0,0"/>
                                        <TextBlock Text="Bir harita ürettikten sonra monument ve dünya kurallarının sonuçları burada açıklanır." Foreground="{StaticResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,7,0,14"/>
                                        <Button Style="{StaticResource PrimaryButton}" Content="Harita oluşturmaya başla  →" HorizontalAlignment="Center" Click="GoStudio_Click"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
                <!-- Settings -->
                <Grid x:Name="SettingsPage" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Margin="2,0,2,12" VerticalAlignment="Center">
                        <TextBlock Text="Ayarlar" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="Harita motorunu, çıktı konumunu ve proje dosyanı yönet." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel HorizontalAlignment="Left" MaxWidth="1550">
                            <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="18">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Top">
                                        <TextBlock Text="RUST HARİTA MOTORU" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                                        <TextBlock Text="Harita üretiminde kullanılan yerel Rust Dedicated motoru." Foreground="#D4DCE3" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="İlk kurulum, doğrulama ve onarım işlemlerini Raven otomatik yönetir." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBox x:Name="RustPathBox" IsReadOnly="True" FontFamily="Cascadia Mono" FontSize="11" ToolTip="Rust sunucu klasörü"/>
                                        <TextBlock x:Name="RustEngineStatusText" Text="• Kontrol ediliyor" FontWeight="SemiBold" FontSize="11" Margin="1,10,0,0"/>
                                        <TextBlock x:Name="RustEngineDetailText" Text="Rust Dedicated ve Harmony dosyaları kontrol ediliyor." Foreground="{StaticResource MutedBrush}" FontSize="9.5" TextWrapping="Wrap" Margin="1,4,0,0"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button Style="{StaticResource ButtonBase}" Content="Klasörü Değiştir" HorizontalAlignment="Left" Padding="14,8" Click="BrowseRust_Click"/>
                                            <Button x:Name="InstallRustEngineButton" Style="{StaticResource PrimaryButton}" Content="Harita Motorunu Kur" HorizontalAlignment="Left" Padding="14,8" Margin="8,0,0,0" Click="InstallRustEngine_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="18">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Top">
                                        <TextBlock Text="HARİTA ÇIKTI KLASÖRÜ" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                                        <TextBlock Text="Üretilen MAP ve PNG dosyalarının kaydedileceği klasör." Foreground="#D4DCE3" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                                        <TextBlock Text="Varsayılan Maps klasörünü kullanabilir veya farklı bir konum seçebilirsiniz." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBox x:Name="OutputPathBox" IsReadOnly="True" FontFamily="Cascadia Mono" FontSize="11" ToolTip="Harita çıktı klasörü"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button Style="{StaticResource ButtonBase}" Content="Klasörü Değiştir" Padding="14,8" Click="BrowseOutput_Click"/>
                                            <Button Style="{StaticResource ButtonBase}" Content="Çıktı Klasörünü Aç" Padding="14,8" Margin="8,0,0,0" Click="OpenMaps_Click"/>
                                            <Button Style="{StaticResource ButtonBase}" Content="Varsayılana Dön" Padding="14,8" Margin="8,0,0,0" Click="ResetOutput_Click"/>
                                        </StackPanel>
                                        <TextBlock x:Name="DefaultMapsText" Foreground="#718190" FontSize="9" Margin="2,9,2,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="18">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Top">
                                        <TextBlock Text="ARAZİ GÜVENLİĞİ" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                                        <TextBlock Text="Taş ve arazi uyumunu süre sınırıyla denetler." Foreground="#D4DCE3" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="God Rock, mağara ve tanınmayan yapılar otomatik olarak değiştirilmez." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <CheckBox x:Name="TerrainFastCheck" Content="Hızlı kontrol · önerilen · en fazla 0,75 saniye" IsChecked="True" Checked="WorldFeature_Changed" Unchecked="WorldFeature_Changed"/>
                                        <CheckBox x:Name="TerrainDeepCheck" Content="Derin kalite kontrolü · isteğe bağlı · en fazla 2,5 saniye" Margin="0,9,0,0" Checked="WorldFeature_Changed" Unchecked="WorldFeature_Changed"/>
                                        <CheckBox x:Name="TerrainSafeRepairCheck" Content="Güvenli otomatik onarım · yalnız doğrulanmış prefab profilleri" IsChecked="True" Margin="0,9,0,0" Checked="WorldFeature_Changed" Unchecked="WorldFeature_Changed"/>
                                        <TextBlock Text="Süre dolarsa kontrol kendini durdurur; harita üretimi bekletilmez. Riskli veya bilinmeyen bir nesne silinmez, taşınmaz ya da kapatılmaz." Foreground="#718190" FontSize="9.5" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource Card}" Padding="18">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Top">
                                        <TextBlock Text="HARİTA AYARLARI" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                                        <TextBlock x:Name="SettingsActiveMapName" Text="RavenHarita" Foreground="#F1F5F8" FontWeight="SemiBold" FontSize="15"/>
                                        <TextBlock Text="Harita seçimlerini bir ayar dosyasına kaydedebilir veya daha önce kaydettiğiniz ayarları yükleyebilirsiniz." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="Kullanılan ayar dosyası" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="1,0,0,5"/>
                                        <TextBox x:Name="CurrentProjectText" IsReadOnly="True" FontFamily="Cascadia Mono" FontSize="10" TextWrapping="Wrap" MinHeight="48" VerticalContentAlignment="Top"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button Style="{StaticResource ButtonBase}" Content="Ayar Yükle" Padding="14,8" Click="OpenProject_Click"/>
                                            <Button Style="{StaticResource PrimaryButton}" Content="Ayarları Kaydet" Padding="14,8" Margin="8,0,0,0" Click="SaveProject_Click"/>
                                            <Button Style="{StaticResource ButtonBase}" Content="Farklı Kaydet" Padding="14,8" Margin="8,0,0,0" Click="SaveProjectAs_Click"/>
                                            <Button Style="{StaticResource ButtonBase}" Content="Klasörü Aç" Padding="14,8" Margin="8,0,0,0" Click="OpenCurrentProjectFolder_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- Logs -->
                <Grid x:Name="LogsPage" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid>
                        <StackPanel><TextBlock Text="Aktivite" Style="{StaticResource PageTitle}"/><TextBlock Text="Üretimin hangi aşamada olduğunu ve önemli sonuçları takip et." Foreground="{StaticResource MutedBrush}"/></StackPanel>
                        <Button Style="{StaticResource ButtonBase}" Content="Temizle" HorizontalAlignment="Right" VerticalAlignment="Center" Click="ClearLog_Click"/>
                    </Grid>
                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,10" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="LogSummaryTitle" Text="SON ÜRETİM ÖZETİ" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                                    <TextBlock Text="  ·  " Foreground="#566573"/>
                                    <TextBlock x:Name="LogSuccessSummary" Text="Başarılı: —" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold"/>
                                    <TextBlock Text="  ·  " Foreground="#566573"/>
                                    <TextBlock x:Name="LogFailureSummary" Text="Sorun: —" Foreground="{StaticResource ErrorBrush}" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="LogSummaryDetail" Grid.Row="1" Text="Henüz harita üretilmedi." Foreground="#B9C7D2" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </Grid>
                    </Border>
                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <StackPanel Margin="0,0,0,9">
                                <TextBlock Text="ÜRETİM ADIMLARI" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Hazırlık · Üretim · Monument · Katman · Doğrulama · Sonuç" Foreground="#718190" FontSize="10" Margin="0,4,0,0"/>
                            </StackPanel>
                            <TextBox x:Name="FullLog" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0" Foreground="#B7C9BE" FontFamily="Cascadia Mono" FontSize="11.5" Padding="8" TextAlignment="Left" HorizontalContentAlignment="Left" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"/>
                            <Border Grid.Row="1" Background="#111A24">
                                <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ElementName=FullLog, Path=Text}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="390">
                                    <Border Width="58" Height="58" CornerRadius="16" Background="#17232E" BorderBrush="#30404D" BorderThickness="1" HorizontalAlignment="Center"><Path Data="{StaticResource IconLogs}" Style="{StaticResource NavPath}" Width="25" Height="25" Stroke="#8D9BAC"/></Border>
                                    <TextBlock Text="Aktivite henüz başlamadı" Foreground="#E6ECF2" FontSize="17" FontWeight="SemiBold" TextAlignment="Center" Margin="0,16,0,0"/>
                                    <TextBlock Text="Üretim başladığında önemli aşamalar ve sonuçlar burada anlaşılır biçimde gösterilir." Foreground="{StaticResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,7,0,14"/>
                                    <Button Style="{StaticResource PrimaryButton}" Content="Harita Studio'ya git  →" HorizontalAlignment="Center" Click="GoStudio_Click"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
        <Border Grid.Row="2" Background="#0D141C" BorderBrush="#222D38" BorderThickness="0,1,0,0">
            <Grid Margin="18,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="6" Height="6" Fill="{StaticResource SuccessBrush}" Margin="0,0,8,0"/><TextBlock Text="Raven License Center" Foreground="#A9B6C4" FontSize="10" FontWeight="SemiBold"/><TextBlock Text="  ·  Çevrimiçi doğrulama" Foreground="#68778A" FontSize="10"/><TextBlock x:Name="BottomAccountStatus" Text="  ·  STANDARD PAKET · Lisans: —" Foreground="#C08B66" FontSize="10" FontWeight="SemiBold"/></StackPanel>
                <TextBlock x:Name="BottomPageStatus" Text="Başlangıç" Foreground="#657482" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="9"/>
            </Grid>
        </Border>
    </Grid>
</Window>
