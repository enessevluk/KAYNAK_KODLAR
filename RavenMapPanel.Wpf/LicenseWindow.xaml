<Window x:Class="RavenMapPanel.LicenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Raven Map Panel - Lisans"
        Width="720" Height="610"
        MinWidth="720" MinHeight="610"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        Icon="Assets/raven-brand-v3.ico">
    <Grid Background="{StaticResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0B1118" BorderBrush="#202B36" BorderThickness="0,0,0,1" Padding="26,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="52" Height="52" Background="#E65022" CornerRadius="8">
                    <Image Source="Assets/raven-brand-v3.png" Width="52" Height="52"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Raven Map Panel" FontSize="22" FontWeight="Bold"/>
                    <TextBlock Text="Merkezi çevrimiçi lisans doğrulaması" Foreground="#8FA0AE" FontSize="11" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="26,22">
                <Border Style="{StaticResource Card}" Padding="18">
                    <StackPanel>
                        <TextBlock Text="RAVEN MAP LİSANSI" Foreground="#E65022" FontSize="10" FontWeight="Bold"/>
                        <TextBlock Text="Aktivasyon anahtarınızı girin" FontSize="18" FontWeight="Bold" Margin="0,6,0,0"/>
                        <TextBlock Text="Uygulama her açılışta ve her harita üretiminden önce lisans merkezine bağlanır. Çevrimdışı üretim yapılamaz."
                                   Foreground="#9EADB9" FontSize="11" TextWrapping="Wrap" LineHeight="17" Margin="0,7,0,14"/>
                        <TextBlock Text="Aktivasyon anahtarı" Foreground="#B8C4CD" FontSize="11" Margin="0,0,0,5"/>
                        <PasswordBox x:Name="ActivationKeyBox" Padding="12,10" FontFamily="Consolas" FontSize="13"
                                     KeyDown="ActivationKeyBox_KeyDown"/>
                        <Button x:Name="ActivateButton" Style="{StaticResource PrimaryButton}" Content="LİSANSI ETKİNLEŞTİR"
                                Padding="12,11" Margin="0,12,0,0" Click="Activate_Click"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="18" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="CİHAZ BAĞI" Foreground="#55A8FF" FontSize="10" FontWeight="Bold"/>
                        <TextBlock Text="Bu lisans bir Windows kurulumuna bağlanır. Bilgisayar değiştirirseniz owner panelinden Raven Map kurulumunu sıfırlayın."
                                   Foreground="#9EADB9" FontSize="11" TextWrapping="Wrap" LineHeight="17" Margin="0,7,0,9"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="DeviceIdText" FontFamily="Consolas" FontSize="10" Foreground="#D6E0E7" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Style="{StaticResource ButtonBase}" Content="KOPYALA" Padding="10,6" Margin="10,0,0,0" Click="CopyDevice_Click"/>
                        </Grid>
                        <TextBlock x:Name="CenterAddressText" Foreground="#667887" FontSize="10" Margin="0,9,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="#0C141B" BorderBrush="#24313D" BorderThickness="1" CornerRadius="7" Padding="14" Margin="0,14,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#728493" Margin="0,4,10,0" VerticalAlignment="Top"/>
                        <TextBlock x:Name="StatusText" Grid.Column="1" Text="Lisans anahtarınızı girin." Foreground="#AEBCC7"
                                   TextWrapping="Wrap" FontSize="11" LineHeight="17"/>
                    </Grid>
                </Border>

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Button x:Name="RetryButton" Grid.Column="0" Style="{StaticResource ButtonBase}" Content="LİSANSI KONTROL ET" Padding="10,9" Click="Retry_Click"/>
                    <Button x:Name="StoreButton" Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="SATIN AL" Padding="10,9" Visibility="Collapsed" Click="Store_Click"/>
                    <Button x:Name="SupportButton" Grid.Column="4" Style="{StaticResource ButtonBase}" Content="DESTEK" Padding="10,9" Visibility="Collapsed" Click="Support_Click"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#0B1118" BorderBrush="#202B36" BorderThickness="0,1,0,0" Padding="26,13">
            <Button Content="Çıkış" Style="{StaticResource ButtonBase}" HorizontalAlignment="Right" Padding="13,7" Click="Exit_Click"/>
        </Border>
    </Grid>
</Window>
