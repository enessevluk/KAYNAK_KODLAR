<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>RavenMapPanel.Core</AssemblyName>
    <RootNamespace>RavenMapPanel</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\RavenMapPanel.Wpf\Assets\icons\*.png" Link="Assets\icons\%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\RavenMapPanel.Wpf\Assets\config\*" Link="Assets\config\%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\RavenMapPanel.Wpf\Assets\data\*" Link="Assets\data\%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\RavenMapPanel.Wpf\Assets\HarmonyMods\*.dll" Link="Assets\HarmonyMods\%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\RavenMapPanel.Wpf\Security\*.pem" Link="Security\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
